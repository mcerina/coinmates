#!/bin/sh
# Coinmates for macOS: the options of the Linux launcher (netplay/flatpak/launch), which follows
# EmuDeck: the ROMs in ~/Emulation/roms/arcade, the settings in ~/Library/Application Support/Coinmates,
# the room logs of the online games in ~/Documents/Coinmates.
app=$(cd "$(dirname "$0")/.." && pwd)
emu=$HOME/Emulation
dir=$HOME/Library/Application\ Support/Coinmates
mkdir -p "$dir/cfg" "$dir/nvram" "$emu/roms/arcade" "$HOME/Documents/Coinmates"
[ -f "$dir/cfg/default.cfg" ] || cp "$app/Resources/default.cfg" "$dir/cfg/"
[ -f "$dir/ui.ini" ] || echo "last_used_filter Available" > "$dir/ui.ini"
cd "$dir" || exit 1
exec "$app/MacOS/coinmates" -rompath "$emu/roms/arcade;$emu/bios;$emu/bios/mame" \
  -samplepath "$emu/storage/mame/samples" -artpath "$emu/storage/mame/artwork" \
  -cfg_directory "$dir/cfg" -nvram_directory "$dir/nvram" -netplay_logs "$HOME/Documents/Coinmates" \
  -joystickprovider sdljoy -joystick_deadzone 0.3 -joystick_saturation 0.85 -video opengl -samplerate 48000 \
  "$@"
