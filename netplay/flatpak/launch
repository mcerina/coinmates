#!/bin/bash
# Coinmates, the command of the flatpak:
#   flatpak run io.github.mcerina.Coinmates   (the list of games: play alone, host or join)
# Paths and options as EmuDeck sets them for MAME (functions/EmuScripts/emuDeckMAME.sh and
# configs/mame of github.com/dragoonDorise/EmuDeck): ROMs in Emulation/roms/arcade, then
# Emulation/bios and Emulation/bios/mame, samples and artwork in Emulation/storage/mame;
# Emulation is in the home or on an SD card. $NP_ROMS replaces the ROM paths. More options for the game
# go in NP_ARGS, e.g. --env=NP_ARGS="-verbose".
# Everybody plays with the player 1 controls, whatever seat they get.
set -e
for e in "$HOME/Emulation" /run/media/*/Emulation /run/media/*/*/Emulation; do
  [ -d "$e/roms/arcade" ] && { EMU=$e; break; }
done
# none yet: the one in the home, which the sandbox can't create (the list of games stays empty until it's there)
EMU=${EMU:-$HOME/Emulation}
NP_ROMS=${NP_ROMS:-$EMU/roms/arcade;$EMU/bios;$EMU/bios/mame}
dir=${XDG_CONFIG_HOME:-$HOME/.config}/coinmates
# the room logs of the online games, to attach to a problem report
logs=$(xdg-user-dir DOCUMENTS 2>/dev/null || echo "$HOME/Documents")/Coinmates
mkdir -p "$dir/cfg" "$dir/nvram" "$logs"
# the controller as EmuDeck sets it for MAME: its default.cfg, and its joystick options
[ -f "$dir/cfg/default.cfg" ] || cp /app/share/coinmates/default.cfg "$dir/cfg/"
# the list starts with the games whose ROMs are there, not the 3000 systems of the drivers
[ -f "$dir/ui.ini" ] || echo "last_used_filter Available" > "$dir/ui.ini"
cd "$dir"   # where the menu writes ui.ini and its other files
# the window's name for the desktop, which then shows the icon of the .desktop file (SDL 2 and 3)
export SDL_VIDEO_X11_WMCLASS=io.github.mcerina.Coinmates SDL_VIDEO_WAYLAND_WMCLASS=io.github.mcerina.Coinmates SDL_APP_ID=io.github.mcerina.Coinmates
# not from EmuDeck: no on-screen keyboard by itself. MAME's SDL3 window starts text input when it opens
# (src/osd/sdl3/window.cpp), and SDL3 then asks Steam for its keyboard when none is attached, as on the
# Deck: at every start of a game. Steam + X still opens it, to type a room code
export SDL_ENABLE_SCREEN_KEYBOARD=0
exec coinmates -rompath "$NP_ROMS" -samplepath "$EMU/storage/mame/samples" -artpath "$EMU/storage/mame/artwork" \
  -cfg_directory "$dir/cfg" -nvram_directory "$dir/nvram" -netplay_logs "$logs" \
  -joystickprovider sdljoy -joystick_deadzone 0.3 -joystick_saturation 0.85 -video opengl -samplerate 48000 \
  $NP_ARGS
